# Server
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jewellery?schema=public

# Admin bootstrap (used on first seed / boot — never commit real values)
ADMIN_BOOTSTRAP_EMAIL=admin@jewellerystore.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe-Dev-Only-12chars

# Session cookies
SESSION_SECRET=dev-session-secret-min-32-characters-long
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Cloudinary (optional for local dev; seed uses external image URLs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
