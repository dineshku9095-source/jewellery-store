{
  "name": "jewellery-store",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build -w @jewellery/shared && npm run build -w @jewellery/backend && npm run build -w @jewellery/frontend",
    "dev:backend": "npm run dev -w @jewellery/backend",
    "dev:frontend": "npm run dev -w @jewellery/frontend",
    "db:generate": "npm run db:generate -w @jewellery/backend",
    "db:migrate": "npm run db:migrate -w @jewellery/backend",
    "db:migrate:dev": "npm run db:migrate:dev -w @jewellery/backend",
    "db:seed": "npm run db:seed -w @jewellery/backend",
    "test": "npm run test -w @jewellery/shared"
  },
  "engines": {
    "node": ">=20"
  }
}
